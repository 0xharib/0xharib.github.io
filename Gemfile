source "https://rubygems.org"

# GitHub Pages builds the live site with its own Jekyll 3.10 environment and
# ignores this Gemfile. Jekyll 4.x is used here only for local preview, because
# the gems GitHub Pages pins are too old to run on modern Ruby.
gem "jekyll", "~> 4.4"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jemoji"
end
